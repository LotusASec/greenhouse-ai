# =============================================================
# Greenhouse AI — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# --- Node Identity ---
# Unique identifier for this greenhouse node
NODE_ID=greenhouse_01
# Maps to simulator/config/<profile>.yaml
NODE_PROFILE=node1

# --- Service URLs (internal Docker DNS) ---
# Used by edge gateway to call model services
DISEASE_SERVICE_URL=http://edge1_disease:8101
IRRIGATION_SERVICE_URL=http://edge1_irrigation:8102
NUTRITION_SERVICE_URL=http://edge1_nutrition:8103
ANOMALY_SERVICE_URL=http://edge1_anomaly:8104
MONITOR_SERVICE_URL=http://edge1_output_monitor:8105
FUSION_SERVICE_URL=http://edge1_fusion:8106
ALARM_SERVICE_URL=http://edge1_alarm:8107
# Used by edge gateway to sync alarms to central
CENTRAL_API_URL=http://central_gateway:9000

# --- Database ---
# Path inside the container where SQLite database file lives
DB_PATH=/data/greenhouse.db

# --- Simulator (Edge Gateway) ---
# Absolute path to the node profile YAML inside the gateway container
SIMULATOR_CONFIG_PATH=/app/simulator/config/node1.yaml
# Absolute path to PlantVillage dataset root (leave empty to disable image simulation)
DATASET_PATH=

# --- Sync ---
# How often (seconds) edge gateway pushes unsynced alarms to central
SYNC_INTERVAL_SECONDS=30
# Alarm Engine: cooldown window in seconds before same rule can fire again
# Monitor alarms (rule_id=None) always bypass this cooldown
ALARM_COOLDOWN_SECONDS=60

# --- Central Layer ---
# Edge node gateway URLs (used by central aggregator to pull alarms)
NODE1_GATEWAY_URL=http://edge1_gateway:8100
NODE2_GATEWAY_URL=http://edge2_gateway:8100
# How often (seconds) central pulls unsynced alarms from each edge
CENTRAL_SYNC_INTERVAL=30
# Central DB path (inside central_gateway container)
CENTRAL_DB_PATH=/data/central.db

# --- LLM Integration ---
# API key for OpenAI-compatible LLM used by central llm_explainer
LLM_API_KEY=your_key_here
# Model ID to use for explanations (gpt-4o-mini is cost-effective)
LLM_MODEL=gpt-4o-mini
# Max tokens per LLM response
LLM_MAX_TOKENS=200

# --- Logging ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

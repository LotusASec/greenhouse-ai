          "queryText": "SELECT CAST(strftime('%s', timestamp) / 60 AS INTEGER) * 60 as time, AVG(temperature) as temperature, AVG(humidity) as humidity, AVG(soil_moisture) as soil_moisture FROM sensor_readings WHERE node_id = '$node_id' AND timestamp >= datetime('now', '-24 hours') GROUP BY CAST(strftime('%s', timestamp) / 60 AS INTEGER) ORDER BY time ASC",
